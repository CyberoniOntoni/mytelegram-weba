# FamilyGram Web — nginx on the Testgram LXC host
# Serves the static build and proxies MTProto web transport to the gateway.
#
# NPM (optional): point web.example.com → this host:8080 with SSL.
# Replace example.com with your domain.

server {
    listen 8080;
    server_name _;

    root /opt/familygram-web/dist;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # MTProto WebSocket (client: wss://web.example.com/apiws)
    location /apiws {
        proxy_pass http://127.0.0.1:30444;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    # MTProto HTTP long-poll fallback (client: https://web.example.com/apiw1)
    location /apiw1 {
        proxy_pass http://127.0.0.1:30444;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    # Cache hashed assets
    location ~* \.(js|css|woff2?|png|svg|webp)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }
}