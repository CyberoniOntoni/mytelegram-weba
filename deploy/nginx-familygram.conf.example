# FamilyGram Web — nginx on the Testgram LXC host (same machine as Docker Compose)
#
# Testgram gateway-server publishes HTTP web transport on host port 30444:
#   docker compose ports: "30444:30444"  (App__Servers__5__Port, Ssl=false)
# nginx proxies browser /apiws and /apiw1 to that host port — NOT into the Docker network.
#
# Traffic chain (production):
#   Browser wss://web.example.com/apiws
#     → NPM :443 (SSL termination, websockets ON)
#     → this nginx :8082  (8080 is often taken by Docker on Testgram hosts)
#     → 127.0.0.1:30444 (Docker-published gateway HTTP/WS port)
#
# Replace example.com with your domain.
# If 8082 is also in use: ss -tlnp | grep -E '808[0-9]' and pick a free port.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8082;
    server_name _;

    root /opt/familygram-web/dist;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # MTProto WebSocket (client: wss://web.example.com/apiws)
    location /apiws {
        proxy_pass http://127.0.0.1:30444;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # MTProto HTTP long-poll fallback (client: https://web.example.com/apiw1)
    location /apiw1 {
        proxy_pass http://127.0.0.1:30444;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # Cache hashed assets
    location ~* \.(js|css|woff2?|png|svg|webp)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }
}