NODE_ENV=development

# From https://my.telegram.org/apps (same credentials as FamilyGram desktop)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# FamilyGram self-hosted Testgram (set to 1 for this fork)
FAMILYGRAM_SELF_HOSTED=1

# Public URL where the built app is served (trailing slash)
BASE_URL=https://web.example.com/
PRODUCTION_HOSTNAME=web.example.com

APP_NAME=FamilyGram Web
APP_TITLE=FamilyGram

# Dev only: Testgram gateway HTTP/WebSocket endpoint for webpack proxy
FAMILYGRAM_GATEWAY_URL=http://127.0.0.1:30444